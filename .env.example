LLM_PROVIDER=gemini
GEMINI_API_KEY=
# The Gemini free tier allowed 15 requests/minute per model when measured.
CLASSIFIER_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=30

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
EMBEDDING_CACHE_DIR=data/models
LEXICAL_MODEL=Qdrant/bm25
# BAAI/bge-reranker-base ranked terminology queries better in local tests but is ~5x slower.
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Escalation gate: minimum cross-encoder score for a passage to count as relevant. Tied to
# RERANKER_MODEL's score scale; recalibrate if the reranker changes.
RELEVANCE_THRESHOLD=2.0
# 0 disables escalation; more than one escalation per question is not allowed.
MAX_ESCALATIONS=1

# Leave QDRANT_URL empty to use the embedded on-disk store at QDRANT_PATH.
QDRANT_URL=
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=sebi_mf_chunks

# Used by docker-compose.yml and the graph builder; change it if Neo4j is reachable beyond localhost.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=inforce-local
NEO4J_DATABASE=neo4j
